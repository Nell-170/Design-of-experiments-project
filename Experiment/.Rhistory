library(pwr)
install.packages("pwr")
library(pwr)
eta_parcial_alg <- 0.00495309
f2_cohen_alg <- eta_parcial_alg / (1 - eta_parcial_alg)
pwr.f2.test(u = 1,
v = 1193,
f2 = f2_cohen_alg,
sig.level = 0.05)
pwr.f2.test(u = 1,
f2 = f2_cohen_alg,
sig.level = 0.05,
power = 0.80)
